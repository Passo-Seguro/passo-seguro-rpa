# Configurações da API Central do Passo Seguro (Nuvem Azure ou Local)
API_BASE_URL=https://ca-passoseguro-app.ashysea-c9ccc16b.centralus.azurecontainerapps.io/api
SERVICE_TOKEN=seu_service_token_aqui

# Configurações do Microsserviço de Visão Computacional (YOLO)
VISION_API_URL=http://localhost:8001/deteccoes
VISION_TOKEN=token-local

# Dados Territoriais e Estatísticos
GEOSAMPA_DATA_PATH=data/geosampa_subprefeituras.geojson
INFOSIGA_CSV_PATH=data/infosiga_sinistros_mock.csv

# Intervalo da Esteira Contínua (em minutos)
INTERVALO_EXECUCAO_MINUTOS=30
LOG_LEVEL=INFO

# Parâmetros de Regras de Negócio
RAIO_DEDUPLICACAO_METROS=30.0
JANELA_DEDUPLICACAO_DIAS=14
RAIO_INFOSIGA_METROS=150.0
LIMIAR_CONFIANCA_VISAO=0.60
